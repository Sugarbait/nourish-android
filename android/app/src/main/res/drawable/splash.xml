<?xml version="1.0" encoding="utf-8"?>
<!--
    Nourish launch splash: dark emerald/teal radial gradient (matches site dark-mode bg)
    with the logo centered on top.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base solid color (covers any area the gradient doesn't reach + Android-11- fallback) -->
    <item>
        <color android:color="#0A1410" />
    </item>

    <!-- Radial gradient: deep emerald glow fading to near-black, matches the site hero -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="600"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#142E26"
                android:centerColor="#0F1F1A"
                android:endColor="#040908" />
        </shape>
    </item>

    <!-- Centered logo -->
    <item
        android:gravity="center"
        android:width="240dp"
        android:height="240dp">
        <bitmap
            android:src="@drawable/splash_logo"
            android:gravity="center"
            android:tileMode="disabled" />
    </item>
</layer-list>
