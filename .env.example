# Local development environment variables
# Copy this file to .env.local and fill in the values

# Convex backend URL (required for food recognition and all API calls)
NEXT_PUBLIC_CONVEX_URL=https://insightful-ox-840.convex.cloud

# Google OAuth client ID (optional - enables Google sign-in)
# Get this from your Google Cloud Console OAuth 2.0 credentials
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id-here

# Microsoft OAuth client ID (optional - enables Microsoft sign-in)
# Default provided in code, override if needed
# NEXT_PUBLIC_MICROSOFT_CLIENT_ID=your-client-id-here
